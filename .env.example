# 라디오 참여 도우미 — 비밀값·서버 설정. 이 파일을 .env 로 복사해 값을 채운다.
# .env 는 GitHub 에 올리지 않는다(.gitignore). 서버에서는 /opt/radio/.env (권한 600).

# Claude API 키 (풀어 쓰기·원고·퀴즈 답). PC 에서는 비워 두면 윈도우 자격 증명 관리자에 저장한 키를 쓴다.
ANTHROPIC_API_KEY=

# GPT(OpenAI) API 키 (0.67, 선택). 설정 → AI 연결에서 'GPT' 를 고르거나 'Claude 로 안 될 때 GPT 로' 를 켤 때만 씀.
OPENAI_API_KEY=

# ── 서버 운영 모드 (Oracle 서버) ─────────────────────────────
# 1 이면 서버 모드: 127.0.0.1:PORT 에만 열고, 모든 접속에 로그인을 받고, 청취·자동 업데이트는 하지 않는다.
# PC 의 .env 에는 넣지 않는다 (PC 는 비워 둠).
RADIO_HELPER_SERVER=1
# 관리 화면 번호 (서버 기본 5002 · PC 기본 5000). Cloudflare 터널이 http://127.0.0.1:5002 를 가리킨다.
PORT=5002
# 밖에서 여는 주소
PUBLIC_URL=https://radio.haetsallab.com
# 데이터(DB·기록·백업) 폴더. 서버: /opt/radio/data (git 에 올라가지 않음)
RADIO_HELPER_DATA_DIR=/opt/radio/data
# 브라우저 자동화는 창 없이 (서버는 화면이 없음)
RADIO_HELPER_HEADLESS=1
# 방송 시간표·예약은 한국 시간 기준
TZ=Asia/Seoul
